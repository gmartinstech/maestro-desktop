{
  "name": "@martinstech/maestro-ds",
  "version": "1.0.0",
  "private": true,
  "description": "Maestro Studio design system — MartinsTech navy/gold tokens, primitives, app shell and screen templates for the desktop app",
  "license": "MIT",
  "type": "module",
  "module": "dist/index.js",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",

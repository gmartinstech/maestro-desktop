{
  "projectId": "dbe5756d-fa67-4ef4-8991-69569bf964bb",
  "shape": "package",
  "pkg": "@martinstech/maestro-ds",
  "globalName": "MaestroDS",
  "buildCmd": "npm --prefix design-system run build",
  "tsconfig": "tsconfig.json",
  "cssEntry": "dist/maestro-ds.css",
  "docsDir": "docs",
  "readmeHeader": ".design-sync/conventions.md",
  "guidelinesGlob": ["docs/guides/**/*.md"],
  "extraFonts": ["src/styles/fonts.css"],
  "runtimeFontPrefixes": ["Cascadia Code"],
  "provider": { "component": "ThemeProvider", "props": { "theme": "light" } },
  "overrides": {
    "Tabs": { "cardMode": "column" },
    "Icon": { "cardMode": "column" },
    "ThemeProvider": { "cardMode": "column" },
    "Tooltip": { "cardMode": "column" },
    "AppShell": { "cardMode": "column" },
    "DashboardScreen": { "cardMode": "column" },
    "SettingsScreen": { "cardMode": "column" },
    "AgentChatScreen": { "cardMode": "column" },
    "Table": { "cardMode": "column" },
    "Sidebar": { "cardMode": "column" },
    "TitleBar": { "cardMode": "column" },
    "CommandPalette": { "cardMode": "column" },
    "Modal": { "cardMode": "column" },
    "AgentCard": { "cardMode": "column" },
    "BrowserCard": { "cardMode": "column" },
    "ViewCard": { "cardMode": "column" },
    "NoteCard": { "cardMode": "column" },
    "CanvasDock": { "cardMode": "column" },
    "CanvasEmptyState": { "cardMode": "column" }
  }
}

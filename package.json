{
  "name": "maestro-desktop",
  "private": true,
  "version": "0.0.0",
  "description": "Maestro Studio — MartinsTech desktop agent orchestrator (fork of Open Swarm)",
  "scripts": {
    "verify": "node scripts/verify.mjs",
    "check:callhome": "node scripts/check-callhome.mjs",
    "e2e:golden": "playwright test e2e/golden --timeout=180000",
    "e2e:golden-turn": "playwright test e2e/contract/golden-turn.spec.ts --timeout=180000",
    "e2e:golden:tauri": "playwright test e2e/golden-tauri --timeout=180000",
    "test:contract": "node scripts/run-contract-tests.mjs",
    "test:contract:engine": "node scripts/run-contract-tests-via-engine.mjs",
    "e2e:golden-turn:engine": "node scripts/run-golden-turn-via-engine.mjs",
    "engine:build": "npm --prefix engine run build",
    "engine:test": "npm --prefix engine test",
    "verify:next": "node scripts/verify-next.mjs",
    "verify:all": "npm run verify && npm run verify:next"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0"
  }
}
